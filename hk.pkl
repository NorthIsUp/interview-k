amends "package://github.com/jdx/hk/releases/download/v1.2.0/hk@1.2.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.2.0/hk@1.2.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["ruff"] = Builtins.ruff
    ["pkl"] {
        glob  = "*.pkl"
        check = "pkl eval {{files}} >/dev/null"
    }
    // Both typecheckers read config from their own directory, so they run whole-project
    // rather than on {{files}} — the projects are small enough that it costs nothing.
    ["pyright"] {
        glob  = "py/**/*.py"
        check = "cd py && uv run pyright"
    }
    ["tsc"] {
        glob  = "ts/**/*.ts"
        check = "cd ts && npx tsc --noEmit"
    }
}

hooks {
    ["pre-commit"] {
        fix   = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps {
            ...linters
            ["pytest"] {
                check = "cd py && uv run pytest"
                exclusive = true
            }
            ["node-test"] {
                check = "cd ts && node --test test/*.test.ts"
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix   = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
